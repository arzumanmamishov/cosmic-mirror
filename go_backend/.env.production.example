# Production environment for docker-compose.prod.yml.
#   cp .env.production.example .env.production   (never commit the copy)
# Generate secrets with:
#   POSTGRES_PASSWORD / REDIS_PASSWORD:  openssl rand -hex 32
#     (hex only: these are pasted unescaped into DATABASE_URL / REDIS_URL,
#      and the / + = in a base64 secret break URL parsing — the API then
#      refuses to boot)
#   JWT_SECRET:                          openssl rand -base64 48

# --- Domain / TLS (Caddy fetches the certificate automatically) ---------
API_DOMAIN=api.livelyapp.co
ACME_EMAIL=you@example.com

# --- Server ----------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
# Browser origins allowed to call the API (the mobile apps don't need CORS).
CORS_ORIGINS=https://livelyapp.co,https://www.livelyapp.co
MIGRATE_ON_START=true

# --- Datastores (REQUIRED, strong, unique; `openssl rand -hex 32`) ---------
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Auth (REQUIRED) -------------------------------------------------------
# 32+ characters; the server refuses to boot otherwise. Changing it logs
# everyone out.
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Email / OTP (REQUIRED — sign-in codes are sent by email) -------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@livelyapp.co
SMTP_FROM_NAME=Lively
SMTP_USE_TLS=true

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=

# --- Stripe (live keys) — web checkout only ---------------------------------
# The mobile apps sell through App Store / Google Play (RevenueCat, below).
# Webhook endpoint to register in Stripe: https://$API_DOMAIN/api/v1/stripe/webhook
# The yearly price gets a 3-day free trial for first-time subscribers.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- RevenueCat (App Store / Google Play in-app purchases) ------------------
# Webhook URL to set in RevenueCat → Integrations → Webhooks:
#   https://$API_DOMAIN/api/v1/subscription/webhook
# REVENUECAT_WEBHOOK_SECRET must equal the "Authorization header value" set
# there (`openssl rand -hex 32`). While empty, the webhook rejects everything
# and in-app purchases never reach the server.
REVENUECAT_WEBHOOK_SECRET=
# Secret API key (sk_…, RevenueCat → Project settings → API keys). Used to
# fetch each subscriber's authoritative state on every webhook. Strongly
# recommended; without it the event payload is trusted as-is.
REVENUECAT_SECRET_API_KEY=
# Entitlement that grants premium (must match the app's 'premium').
REVENUECAT_ENTITLEMENT_ID=premium

# --- Firebase (push notifications) ------------------------------------------
# Mount the service-account JSON into the container and point at it.
FIREBASE_CREDENTIALS_PATH=

# --- Community moderation (App Store 1.2 / Google Play UGC) -----------------
# Inbox that gets one email per new report. Apple and Google expect action
# within 24 hours. Uses the SMTP settings above. Empty means reports are only
# stored.
MODERATION_EMAIL=
# Comma-separated account emails allowed to use /api/v1/admin/* (moderation
# queue). Empty means nobody can.
ADMIN_EMAILS=
# Number of reports from different users that hides a post or comment until
# it's reviewed. 0 turns auto-hide off.
MODERATION_AUTOHIDE_THRESHOLD=3

# --- Limits -----------------------------------------------------------------
FREE_TIER_CHAT_LIMIT=5
FREE_TIER_RATE_LIMIT=60
PREMIUM_RATE_LIMIT=120
