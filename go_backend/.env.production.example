# Production environment for docker-compose.prod.yml.
#   cp .env.production.example .env.production   (never commit the copy)
# Generate secrets with:  openssl rand -base64 48

# --- Domain / TLS (Caddy fetches the certificate automatically) ---------
API_DOMAIN=api.livelyapp.co
ACME_EMAIL=you@example.com

# --- Server ----------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
# Browser origins allowed to call the API (the mobile apps don't need CORS).
CORS_ORIGINS=https://livelyapp.co,https://www.livelyapp.co
MIGRATE_ON_START=true

# --- Datastores (REQUIRED, strong, unique) ----------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Auth (REQUIRED) -------------------------------------------------------
# 32+ characters; the server refuses to boot otherwise. Changing it logs
# everyone out.
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Email / OTP (REQUIRED — sign-in codes are sent by email) -------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@livelyapp.co
SMTP_FROM_NAME=Lively
SMTP_USE_TLS=true

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=

# --- Stripe (live keys) -----------------------------------------------------
# Webhook endpoint to register in Stripe: https://$API_DOMAIN/api/v1/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- RevenueCat (optional; leave empty to keep its webhook disabled) -------
REVENUECAT_WEBHOOK_SECRET=

# --- Firebase (push notifications) ------------------------------------------
# Mount the service-account JSON into the container and point at it.
FIREBASE_CREDENTIALS_PATH=

# --- Limits -----------------------------------------------------------------
FREE_TIER_CHAT_LIMIT=5
FREE_TIER_RATE_LIMIT=60
PREMIUM_RATE_LIMIT=120
