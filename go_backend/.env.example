# Server
PORT=8080
ENVIRONMENT=dev
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgres://cosmic:cosmic_secret@localhost:5432/cosmic_mirror?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Firebase — now only used for FCM push notifications, NOT auth.
# Auth moved to first-party email-OTP + JWT (see SMTP + JWT sections below).
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# SMTP — delivers the 6-digit OTP codes for register / login / password reset.
# Leave SMTP_HOST blank in dev: the mailer becomes a no-op that prints the code
# to the server log. Fill in to send real email.
#   • port 587 + SMTP_USE_TLS=true → STARTTLS (Gmail, SES, Postmark, SendGrid…)
#   • port 465                     → implicit TLS (SMTP_USE_TLS ignored)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@livelyapp.co
SMTP_FROM_NAME=Lively
SMTP_USE_TLS=true

# JWT — signs local access tokens (HS256). Refresh tokens are opaque and stored
# server-side. Required outside dev; keep stable and secret. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Swiss Ephemeris data path (directory with .se1 files)
EPHEMERIS_PATH=./ephemeris

# RevenueCat (legacy / optional — Stripe is the active subscription path)
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# Stripe — premium subscriptions via the mobile Payment Sheet.
# Secret key powers server-side calls (creating customers, subscriptions,
# ephemeral keys). Publishable key is safe to ship in the mobile binary —
# we hand it back to the client via /api/v1/stripe/payment-sheet.
# Webhook secret is used to verify signed events from Stripe → us.
# Price IDs come from your Stripe dashboard products.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me_monthly
STRIPE_PRICE_YEARLY=price_replace_me_yearly

# Rate Limiting
FREE_TIER_CHAT_LIMIT=3
FREE_TIER_RATE_LIMIT=60
PREMIUM_RATE_LIMIT=120
